# 复制为 .env 后填写（密码勿提交仓库）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/MAIN_DB?schema=public"
# 与 schema.prisma 中 shadowDatabaseUrl 对应：空库，仅用于 prisma migrate dev 校验
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/feedgen_prisma_shadow?schema=public"

# 新闻 AI 分类 ML Sidecar（Python，内网 3010，勿对公网暴露）
ML_SERVICE_URL=http://127.0.0.1:3010
ML_SERVICE_TOKEN=your-internal-token
CLASSIFICATION_ENABLED=1

# 金融产品标签（词典同步 + 标题匹配 + K 线链接）
FINANCE_MATCH_ENABLED=1
FINANCE_DICT_SYNC_ENABLED=1
FINANCE_DICT_SYNC_INTERVAL_MS=86400000
FINANCE_KLINE_URL_TEMPLATE=http://127.0.0.1:8765/?symbol={symbol}&period={period}
FINANCE_KLINE_DEFAULT_PERIOD=1d
# meostock 反代资讯时间线用的机机令牌（Authorization: Bearer 或 X-Service-Token）
FEEDGEN_SERVICE_TOKEN=local-dev-feedgen-service-token
# 文章 reader_url 前缀（可选）
# FEEDGEN_PUBLIC_BASE_URL=http://127.0.0.1:3000
# YFINANCE_PYTHON=python3
# YFINANCE_SCRIPT=/www/wwwroot/feedgen/scripts/yfinance_sync.py

# 翻译服务说明：
# 推荐在前端「设置 → AI 设置」中配置（支持腾讯 TMT、本机 MTranServer、Gemini）。
# 本机 MTranServer 默认地址：http://127.0.0.1:8989（见 /Users/meetrice/pro/translate）
# 下列环境变量仅为旧版兼容 / Gemini 默认密钥示例，实际以用户设置页配置为准。
TENCENT_TMT_SECRET_ID=your-secret-id
TENCENT_TMT_SECRET_KEY=your-secret-key
TENCENT_TMT_REGION=ap-guangzhou
TRANSLATION_ENABLED=1

# Gemini 免费翻译（设置页可选；默认经 127.0.0.1:7890 代理，思考模式关闭）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TRANSLATE_CONCURRENCY=1
# GEMINI_TRANSLATE_MIN_INTERVAL_MS=1000

# OpenAI 兼容翻译（局域网 bridge）
OPENAI_TRANSLATE_BASE_URL=http://192.168.31.60:3921/v1
OPENAI_TRANSLATE_API_KEY=your-openai-compatible-api-key
OPENAI_TRANSLATE_MODEL=bridge__deepseek
# OPENAI_TRANSLATE_CONCURRENCY=1
# OPENAI_TRANSLATE_MIN_INTERVAL_MS=8000
# TRANSLATE_BATCH_ARTICLE_GAP_MS=4000

# Index-Translate（哔哩哔哩免费公开 API，无需 Key）
INDEX_TRANSLATE_BASE_URL=https://index-translate.bilibili.com/v1
INDEX_TRANSLATE_MODEL=Index-Translate-35B-A3B
# INDEX_TRANSLATE_CONCURRENCY=1
# INDEX_TRANSLATE_MIN_INTERVAL_MS=1500

# DeepSeek（visual-parser 一键 AI 爬虫解析）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MAX_HTML_CHARS=180000
