generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique @db.VarChar(100)
  email              String               @unique @db.VarChar(255)
  password_hash      String               @db.VarChar(255)
  current_plan_id    Int?
  plan_start_date    DateTime?            @db.Date
  plan_end_date      DateTime?            @db.Date
  feed_count_used    Int?                 @default(0)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  is_anonymous       Boolean              @default(false)
  is_admin           Boolean              @default(false)
  browser_meta       Json?
  feeds              Feed[]
  feed_groups        UserFeedGroup[]
  article_likes      UserArticleLike[]
  article_reads      UserArticleRead[]
  tags                       UserTag[]
  article_tags               UserArticleTag[]
  classification_annotations ClassificationAnnotation[]
  user_subscriptions         user_subscriptions[]
  user_plans         user_plans?          @relation(fields: [current_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  translation_config UserTranslationConfig?
  insight_recipes            UserInsightRecipe[]
  insight_recipe_runs        UserInsightRecipeRun[]
  contributed_public_feeds   PublicFeed[]              @relation("PublicFeedContributor")
  public_feed_subscriptions  UserFeedSubscription[]
  public_feed_share_requests PublicFeedShareRequest[]  @relation("ShareRequestApplicant")
  reviewed_share_requests    PublicFeedShareRequest[]  @relation("ShareRequestReviewer")

  @@index([current_plan_id], map: "idx_users_current_plan")
  @@map("users")
}

model UserTranslationConfig {
  user_id    Int      @id
  provider   String   @default("tencent") @db.VarChar(32)
  secret_id  String   @default("") @db.VarChar(128)
  secret_key String   @default("") @db.VarChar(128)
  region     String   @default("ap-guangzhou") @db.VarChar(32)
  base_url   String?  @db.VarChar(500)
  api_token  String?  @db.VarChar(256)
  enabled    Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_translation_configs")
}

model Feed {
  id                   Int       @id @default(autoincrement())
  user_id              Int?
  group_id             Int?
  title                String    @db.VarChar(255)
  description          String?
  url                  String?   @db.VarChar(500)
  favicon_url          String?   @db.VarChar(2000)
  favicon_custom_text  String?   @db.VarChar(12)
  favicon_custom_bg    String?   @db.VarChar(16)
  anti_bot_status      String    @default("normal") @db.VarChar(32)
  anti_bot_detected_at DateTime? @db.Timestamp(6)
  anti_bot_message     String?   @db.Text
  auth_cookie          String?   @db.Text
  feed_type       String?   @default("rss") @db.VarChar(50)
  source_type     String    @default("native") @db.VarChar(20)
  is_active       Boolean?  @default(true)
  selector_rules  Json?
  update_interval Int?      @default(1800)
  sort_order      Int       @default(0)
  use_proxy          Boolean   @default(false)
  needs_translation  Boolean   @default(false)
  last_fetched_at    DateTime? @db.Timestamp(6)
  public_feed_id     Int?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  users           User?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group           UserFeedGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  public_feed     PublicFeed? @relation(fields: [public_feed_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  articles        Article[]
  crawler_task_histories CrawlerTaskHistory[]
  crawler_strategy FeedCrawlerStrategy?
  share_requests  PublicFeedShareRequest[]

  @@index([is_active], map: "idx_feeds_is_active")
  @@index([public_feed_id], map: "idx_feeds_public_feed_id")
  @@index([user_id], map: "idx_feeds_user_id")
  @@index([group_id], map: "idx_feeds_group_id")
  @@index([source_type], map: "idx_feeds_source_type")
  @@index([anti_bot_status], map: "idx_feeds_anti_bot_status")
  @@index([user_id, sort_order], map: "idx_feeds_user_sort_order")
  @@map("feeds")
}

model FeedCrawlerStrategy {
  id                   Int       @id @default(autoincrement())
  feed_id              Int       @unique
  strategy_mode        String    @default("auto") @db.VarChar(32)
  recommended_interval Int?      @db.Integer
  min_interval         Int       @default(1800) @db.Integer
  max_interval         Int       @default(86400) @db.Integer
  cooldown_until       DateTime? @db.Timestamp(6)
  failure_threshold    Int       @default(3) @db.Integer
  auto_disable_enabled Boolean   @default(false)
  note                 String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @db.Timestamp(6)
  feed                 Feed      @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cooldown_until], map: "idx_feed_crawler_strategies_cooldown_until")
  @@map("feed_crawler_strategies")
}

model UserFeedGroup {
  id            Int                    @id @default(autoincrement())
  user_id       Int
  name          String                 @db.VarChar(100)
  icon          String?                @db.VarChar(50)
  sort_order    Int                    @default(0)
  created_at    DateTime               @default(now()) @db.Timestamp(6)
  updated_at    DateTime               @default(now()) @db.Timestamp(6)
  user          User                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feeds         Feed[]
  public_subscriptions UserFeedSubscription[]

  @@unique([user_id, name], map: "ux_user_feed_groups_user_name")
  @@index([user_id], map: "idx_user_feed_groups_user_id")
  @@index([user_id, sort_order], map: "idx_user_feed_groups_user_sort_order")
  @@map("user_feed_groups")
}

model user_plans {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  description        String?
  max_feeds          Int?                 @default(0)
  price              Decimal?             @default(0.00) @db.Decimal(10, 2)
  duration_days      Int?                 @default(30)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  user_subscriptions user_subscriptions[]
  users              User[]
}

model membership_plan_configs {
  id                 Int      @id
  name               String   @db.VarChar(100)
  description        String?
  price_label        String?  @db.VarChar(50)
  price_suffix       String?  @db.VarChar(20)
  max_feeds                Int      @default(0)
  max_private_feeds        Int      @default(3)
  max_public_subscriptions Int      @default(30)
  min_fetch_interval Int      @default(1800)
  history_days       Int      @default(30)
  storage_mb         Int      @default(500)
  highlight          Boolean  @default(false)
  sort_order         Int      @default(0)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)

  @@map("membership_plan_configs")
}

model user_subscriptions {
  id             Int         @id @default(autoincrement())
  user_id        Int?
  plan_id        Int?
  start_date     DateTime    @db.Date
  end_date       DateTime    @db.Date
  amount_paid    Decimal     @db.Decimal(10, 2)
  transaction_id String?     @db.VarChar(255)
  status         String?     @default("active") @db.VarChar(50)
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  updated_at     DateTime?   @default(now()) @db.Timestamp(6)
  user_plans     user_plans? @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          User?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plan_id], map: "idx_user_subscriptions_plan_id")
  @@index([user_id], map: "idx_user_subscriptions_user_id")
}

model PublicFeed {
  id                   Int       @id @default(autoincrement())
  title                String    @db.VarChar(255)
  description          String?
  url                  String    @db.VarChar(500)
  url_normalized       String    @db.VarChar(500)
  source_type          String    @default("native") @db.VarChar(20)
  selector_rules       Json?
  selector_fingerprint String?   @db.VarChar(64)
  source_fingerprint   String    @unique @db.VarChar(64)
  feed_type            String?   @default("rss") @db.VarChar(50)
  favicon_url          String?   @db.VarChar(2000)
  update_interval      Int?      @default(1800)
  use_proxy            Boolean   @default(false)
  anti_bot_status      String    @default("normal") @db.VarChar(32)
  anti_bot_detected_at DateTime? @db.Timestamp(6)
  anti_bot_message     String?   @db.Text
  requires_auth        Boolean   @default(false)
  status               String    @default("approved") @db.VarChar(20)
  is_active            Boolean   @default(true)
  verified             Boolean   @default(false)
  tags                 Json?
  contributor_user_id  Int?
  subscriber_count     Int       @default(0)
  last_fetched_at      DateTime? @db.Timestamp(6)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @db.Timestamp(6)
  contributor          User?     @relation("PublicFeedContributor", fields: [contributor_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  articles             Article[]
  subscriptions        UserFeedSubscription[]
  linked_feeds         Feed[]

  @@index([status, subscriber_count(sort: Desc)], map: "idx_public_feeds_status_subscribers")
  @@index([url_normalized], map: "idx_public_feeds_url_normalized")
  @@map("public_feeds")
}

model UserFeedSubscription {
  id                Int            @id @default(autoincrement())
  user_id           Int
  public_feed_id    Int
  group_id          Int?
  custom_title      String?        @db.VarChar(255)
  sort_order        Int            @default(0)
  needs_translation Boolean        @default(false)
  is_active         Boolean        @default(true)
  created_at        DateTime       @default(now()) @db.Timestamp(6)
  updated_at        DateTime       @default(now()) @db.Timestamp(6)
  user              User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  public_feed       PublicFeed     @relation(fields: [public_feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  group             UserFeedGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([user_id, public_feed_id], map: "ux_user_feed_subscriptions_user_public_feed")
  @@index([user_id, sort_order], map: "idx_user_feed_subscriptions_user_sort")
  @@index([public_feed_id], map: "idx_user_feed_subscriptions_public_feed")
  @@map("user_feed_subscriptions")
}

model PublicFeedShareRequest {
  id              Int       @id @default(autoincrement())
  user_id         Int
  private_feed_id Int
  status          String    @default("pending") @db.VarChar(20)
  reviewed_by     Int?
  reject_reason   String?
  submitted_at    DateTime  @default(now()) @db.Timestamp(6)
  reviewed_at     DateTime? @db.Timestamp(6)
  user            User      @relation("ShareRequestApplicant", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  private_feed    Feed      @relation(fields: [private_feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer        User?     @relation("ShareRequestReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, submitted_at(sort: Desc)], map: "idx_public_feed_share_requests_status")
  @@index([private_feed_id], map: "idx_public_feed_share_requests_feed")
  @@map("public_feed_share_requests")
}

model Article {
  id            Int      @id @default(autoincrement())
  feed_id       Int?
  public_feed_id Int?
  title            String   @db.VarChar(500)
  title_zh         String?  @db.VarChar(500)
  content          String?
  description      String?
  description_zh   String?  @db.Text
  url           String?  @db.VarChar(1000)
  thumbnail_url String?  @db.VarChar(1000)
  author        String?  @db.VarChar(255)
  pub_date      DateTime?
  /// 规范化标题（查重用）
  title_norm       String?  @db.VarChar(500)
  /// 64-bit SimHash
  title_simhash    BigInt?
  dup_cluster_id   Int?
  dup_is_primary   Boolean  @default(true)
  dup_checked_at   DateTime? @db.Timestamp(6)
  /// 正文抓取状态冗余：none|pending|success|failed|skipped|blocked
  fulltext_status  String?  @db.VarChar(32)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
  feeds         Feed?     @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  public_feed   PublicFeed? @relation(fields: [public_feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dup_cluster                ArticleDupCluster? @relation(fields: [dup_cluster_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fulltext                   ArticleFulltext?
  user_likes                 UserArticleLike[]
  user_reads                 UserArticleRead[]
  user_tags                  UserArticleTag[]
  classification             ArticleClassification?
  classification_annotations ClassificationAnnotation[]
  finance_instruments        ArticleFinanceInstrument[]
  importance                 ArticleImportance?

  @@index([feed_id], map: "idx_articles_feed_id")
  @@index([public_feed_id], map: "idx_articles_public_feed_id")
  @@index([dup_checked_at], map: "idx_articles_dup_checked")
  @@index([dup_cluster_id], map: "idx_articles_dup_cluster")
  @@index([title_norm, pub_date], map: "idx_articles_title_norm_pub")
  @@index([title_simhash], map: "idx_articles_title_simhash")
  @@index([fulltext_status], map: "idx_articles_fulltext_status")
  @@map("articles")
}

/// 原文正文（按重要度阈值异步抓取；与列表热路径隔离）
model ArticleFulltext {
  article_id               Int       @id
  status                   String    @db.VarChar(32)
  body_html                String?   @db.Text
  body_text                String?   @db.Text
  word_count               Int       @default(0)
  byte_size                Int       @default(0)
  extractor                String?   @db.VarChar(40)
  http_status              Int?
  final_url                String?   @db.VarChar(1000)
  error                    String?   @db.Text
  fetched_at               DateTime? @db.Timestamp(6)
  /// 中文正文 HTML（块结构与原文对应）
  body_html_zh             String?   @db.Text
  body_text_zh             String?   @db.Text
  /// none|pending|success|failed|skipped
  translation_status       String?   @db.VarChar(32)
  translation_error        String?   @db.Text
  translated_at            DateTime? @db.Timestamp(6)
  /// 原文 body_html 哈希；变更后需重翻
  translation_source_hash  String?   @db.VarChar(64)
  /// [{ en, zh }, ...] 段落对照
  translation_segments     Json?
  created_at               DateTime  @default(now()) @db.Timestamp(6)
  updated_at               DateTime  @default(now()) @db.Timestamp(6)
  article                  Article   @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, updated_at], map: "idx_article_fulltexts_status_updated")
  @@index([translation_status], map: "idx_article_fulltexts_translation_status")
  @@map("article_fulltexts")
}

/// 同日近重复标题簇（最早一条为 primary）
model ArticleDupCluster {
  id                 Int       @id @default(autoincrement())
  run_day            DateTime  @db.Date
  primary_article_id Int
  member_count       Int       @default(1)
  sample_title       String    @db.VarChar(500)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)
  articles           Article[]

  @@index([run_day, member_count(sort: Desc)], map: "idx_article_dup_clusters_day_count")
  @@index([primary_article_id], map: "idx_article_dup_clusters_primary")
  @@map("article_dup_clusters")
}

/// 系统定时/后台任务注册表
model SystemJob {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  cron        String   @db.VarChar(64)
  enabled     Boolean  @default(true)
  queue_name  String?  @db.VarChar(80)
  config      Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  runs        SystemJobRun[]

  @@map("system_jobs")
}

/// 系统任务运行记录
model SystemJobRun {
  id            Int       @id @default(autoincrement())
  job_key       String    @db.VarChar(64)
  status        String    @db.VarChar(32)
  progress      Int       @default(0)
  progress_text String?   @db.VarChar(255)
  started_at    DateTime? @db.Timestamp(6)
  finished_at   DateTime? @db.Timestamp(6)
  error         String?   @db.Text
  stats         Json?
  triggered_by  String    @default("cron") @db.VarChar(32)
  bull_job_id   String?   @db.VarChar(80)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  job           SystemJob @relation(fields: [job_key], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@index([job_key, created_at(sort: Desc)], map: "idx_system_job_runs_job_created")
  @@index([status], map: "idx_system_job_runs_status")
  @@map("system_job_runs")
}

model UserArticleLike {
  user_id    Int
  article_id Int
  liked_at   DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  article    Article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, article_id])
  @@index([user_id, liked_at(sort: Desc)], map: "idx_user_article_likes_user_liked_at")
  @@map("user_article_likes")
}

/// 用户文章阅读记录
model UserArticleRead {
  user_id    Int
  article_id Int
  read_at    DateTime  @default(now()) @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  article    Article   @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, article_id])
  @@map("user_article_reads")
}

/// 用户订阅主题（原标签词汇表；对外文案为「主题」）
model UserTag {
  id           Int              @id @default(autoincrement())
  user_id      Int
  name         String           @db.VarChar(50)
  slug         String?          @db.VarChar(60)
  color        String?          @db.VarChar(16)
  icon         String?          @db.VarChar(50)
  /// 主题重要程度 1–5，侧栏标签云字号据此缩放
  importance   Int              @default(3)
  sort_order   Int              @default(0)
  created_at   DateTime         @default(now()) @db.Timestamp(6)
  updated_at   DateTime         @default(now()) @db.Timestamp(6)
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  article_tags UserArticleTag[]
  keywords     UserTagKeyword[]

  @@unique([user_id, name], map: "ux_user_tags_user_name")
  @@index([user_id, sort_order], map: "idx_user_tags_user_sort")
  @@map("user_tags")
}

/// 主题关联关键词（任一命中 title/summary 即自动挂主题）
model UserTagKeyword {
  id           Int      @id @default(autoincrement())
  tag_id       Int
  keyword      String   @db.VarChar(80)
  keyword_norm String   @db.VarChar(80)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  tag          UserTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tag_id, keyword_norm], map: "ux_user_tag_keywords_tag_norm")
  @@index([tag_id], map: "idx_user_tag_keywords_tag")
  @@map("user_tag_keywords")
}

/// 用户文章与标签关联
model UserArticleTag {
  user_id    Int
  article_id Int
  tag_id     Int
  source     String   @default("manual") @db.VarChar(20)
  tagged_at  DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  article    Article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag        UserTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, article_id, tag_id])
  @@index([user_id, tag_id, tagged_at(sort: Desc)], map: "idx_user_article_tags_user_tag_time")
  @@index([user_id, article_id], map: "idx_user_article_tags_user_article")
  @@map("user_article_tags")
}

/// 爬虫任务执行历史（调度器 native/visual 与 Bull 队列）
model CrawlerTaskHistory {
  id                 Int       @id @default(autoincrement())
  feed_id            Int
  mode               String    @db.VarChar(32)
  status             String    @db.VarChar(32)
  started_at         DateTime  @db.Timestamp(6)
  finished_at        DateTime? @db.Timestamp(6)
  duration_ms        Int?
  new_articles_count Int       @default(0)
  error_message      String?   @db.Text
  feed               Feed      @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([feed_id, started_at(sort: Desc)], map: "idx_crawler_task_histories_feed_started")
  @@map("crawler_task_histories")
}

/// 新闻主题类别（系统级，Admin 管理）
model NewsCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  color       String?  @db.VarChar(16)
  status      String   @default("active") @db.VarChar(16)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)

  examples        NewsCategoryExample[]
  prototype       NewsCategoryPrototype?
  classifications ArticleClassification[]
  annotations     ClassificationAnnotation[]

  @@index([status, sort_order], map: "idx_news_categories_status_sort")
  @@map("news_categories")
}

/// 类别示例标题（冷启动）
model NewsCategoryExample {
  id          Int          @id @default(autoincrement())
  category_id Int
  title       String       @db.Text
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  category    NewsCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category_id], map: "idx_news_category_examples_category")
  @@map("news_category_examples")
}

/// 类别原型向量（冷启动兜底）
model NewsCategoryPrototype {
  id            Int          @id @default(autoincrement())
  category_id   Int          @unique
  embedding     Bytes
  example_count Int          @default(0)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)
  category      NewsCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("news_category_prototypes")
}

/// 文章 AI 分类结果（每篇文章保留最新一条）
model ArticleClassification {
  id            Int           @id @default(autoincrement())
  article_id    Int           @unique
  category_id   Int?
  confidence    Float?
  model_version String?       @db.VarChar(32)
  need_review   Boolean       @default(false)
  classified_at DateTime      @default(now()) @db.Timestamp(6)
  article       Article       @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category      NewsCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([category_id], map: "idx_article_classifications_category")
  @@index([need_review, classified_at(sort: Desc)], map: "idx_article_classifications_review")
  @@map("article_classifications")
}

/// 人工标注记录（训练数据核心）
model ClassificationAnnotation {
  id              Int          @id @default(autoincrement())
  article_id      Int
  category_id     Int
  labeled_by      Int?
  source          String       @default("manual") @db.VarChar(20)
  model_version   String?      @db.VarChar(32)
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  article         Article      @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category        NewsCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  labeled_by_user User?        @relation(fields: [labeled_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([category_id], map: "idx_classification_annotations_category")
  @@index([article_id, created_at(sort: Desc)], map: "idx_classification_annotations_article")
  @@map("classification_annotations")
}

/// 训练任务
model ClassificationTrainingJob {
  id             Int       @id @default(autoincrement())
  status         String    @default("pending") @db.VarChar(16)
  progress       Int       @default(0)
  stage          String?   @db.VarChar(32)
  train_count    Int?
  val_count      Int?
  category_count Int?
  trigger_reason String?   @db.VarChar(128)
  metrics_json   String?   @db.Text
  model_version  String?   @db.VarChar(32)
  error_msg      String?   @db.Text
  started_at     DateTime? @db.Timestamp(6)
  finished_at    DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([status, created_at(sort: Desc)], map: "idx_classification_training_jobs_status")
  @@map("classification_training_jobs")
}

/// 模型版本
model ClassificationModelVersion {
  id         Int      @id @default(autoincrement())
  version    String   @unique @db.VarChar(32)
  path       String   @db.Text
  metrics    String?  @db.Text
  is_active  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@map("classification_model_versions")
}

/// 金融产品规范词典（系统级）
model FinanceInstrument {
  id            Int                        @id @default(autoincrement())
  symbol        String                     @db.VarChar(64)
  chart_symbol  String                     @db.VarChar(64)
  name          String                     @db.VarChar(255)
  name_en       String?                    @db.VarChar(255)
  market        String                     @db.VarChar(16)
  asset_type    String                     @default("stock") @db.VarChar(16)
  exchange      String?                    @db.VarChar(32)
  currency      String?                    @db.VarChar(8)
  source        String                     @default("stock_sdk") @db.VarChar(32)
  status        String                     @default("active") @db.VarChar(16)
  priority      Int                        @default(100)
  meta          Json?
  synced_at     DateTime?                  @db.Timestamp(6)
  created_at    DateTime                   @default(now()) @db.Timestamp(6)
  updated_at    DateTime                   @default(now()) @db.Timestamp(6)
  aliases       FinanceAlias[]
  articles      ArticleFinanceInstrument[]

  @@unique([market, symbol], map: "ux_finance_instruments_market_symbol")
  @@index([status, market], map: "idx_finance_instruments_status_market")
  @@index([asset_type], map: "idx_finance_instruments_asset_type")
  @@map("finance_instruments")
}

/// 金融产品关键词别名
model FinanceAlias {
  id             Int               @id @default(autoincrement())
  instrument_id  Int
  keyword        String            @db.VarChar(255)
  keyword_norm   String            @db.VarChar(255)
  kind           String            @default("alias") @db.VarChar(16)
  enabled        Boolean           @default(true)
  source         String            @default("auto") @db.VarChar(16)
  created_at     DateTime          @default(now()) @db.Timestamp(6)
  updated_at     DateTime          @default(now()) @db.Timestamp(6)
  instrument     FinanceInstrument @relation(fields: [instrument_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([keyword_norm], map: "ux_finance_aliases_keyword_norm")
  @@index([instrument_id], map: "idx_finance_aliases_instrument")
  @@index([enabled], map: "idx_finance_aliases_enabled")
  @@map("finance_aliases")
}

/// 文章与金融产品关联
model ArticleFinanceInstrument {
  article_id       Int
  instrument_id    Int
  matched_keyword  String             @db.VarChar(255)
  matched_field    String             @db.VarChar(32)
  confidence       Float              @default(1)
  matched_at       DateTime           @default(now()) @db.Timestamp(6)
  article          Article            @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  instrument       FinanceInstrument  @relation(fields: [instrument_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([article_id, instrument_id])
  @@index([instrument_id], map: "idx_article_finance_instruments_instrument")
  @@index([article_id, matched_at(sort: Desc)], map: "idx_article_finance_instruments_article_time")
  @@map("article_finance_instruments")
}

/// 金融词典同步任务
model FinanceSyncJob {
  id              Int       @id @default(autoincrement())
  status          String    @default("pending") @db.VarChar(16)
  mode            String    @default("full") @db.VarChar(16)
  trigger         String    @default("manual") @db.VarChar(16)
  source          String?   @db.VarChar(64)
  fetched_count   Int       @default(0)
  created_count   Int       @default(0)
  updated_count   Int       @default(0)
  disabled_count  Int       @default(0)
  alias_count     Int       @default(0)
  error_msg       String?   @db.Text
  started_at      DateTime? @db.Timestamp(6)
  finished_at     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  @@index([status, created_at(sort: Desc)], map: "idx_finance_sync_jobs_status")
  @@map("finance_sync_jobs")
}

/// 金融功能应用设置（key-value）
model FinanceAppSetting {
  key        String   @id @db.VarChar(64)
  value      String   @db.Text
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@map("finance_app_settings")
}

/// 文章重要度评分（系统级，1–5 星）
model ArticleImportance {
  id            Int      @id @default(autoincrement())
  article_id    Int      @unique
  stars         Int
  score         Float
  factors       Json?
  model_version String?  @db.VarChar(32)
  scored_at     DateTime @default(now()) @db.Timestamp(6)
  article       Article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([stars, scored_at(sort: Desc)], map: "idx_article_importance_stars_scored")
  @@index([score(sort: Desc)], map: "idx_article_importance_score")
  @@map("article_importance")
}

/// 信源权威权重（按域名或 Feed）
model ImportanceSourceWeight {
  id         Int      @id @default(autoincrement())
  host       String?  @db.VarChar(255)
  feed_id    Int?
  weight     Float    @default(50)
  note       String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@unique([host], map: "ux_importance_source_weights_host")
  @@unique([feed_id], map: "ux_importance_source_weights_feed")
  @@index([weight], map: "idx_importance_source_weights_weight")
  @@map("importance_source_weights")
}

/// 用户 AI 洞察配方（可编辑提示词，作用于当前文章列表）
model UserInsightRecipe {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  /// 内置标识：summary / mining；自定义为 null
  builtin_key          String?  @db.VarChar(32)
  name                 String   @db.VarChar(80)
  description          String?  @db.VarChar(255)
  icon                 String?  @db.VarChar(50)
  system_prompt        String   @db.Text
  user_prompt_template String   @db.Text
  /// JSON 数组：title / summary / source
  context_fields       Json     @default("[\"title\"]")
  enabled              Boolean  @default(true)
  is_builtin           Boolean  @default(false)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @db.Timestamp(6)
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                 UserInsightRecipeRun[]

  @@unique([user_id, builtin_key], map: "ux_user_insight_recipes_user_builtin")
  @@index([user_id, sort_order], map: "idx_user_insight_recipes_user_sort")
  @@map("user_insight_recipes")
}

/// 洞察配方运行结果（按用户+配方+阅读范围+自然日保存版本历史）
model UserInsightRecipeRun {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  recipe_id            Int
  /// 规范化范围键，如 feed:123|day:today
  scope_key            String   @db.VarChar(191)
  scope_label          String   @db.VarChar(255)
  /// 自然日（前端本地日 YYYY-MM-DD）
  run_day              DateTime @db.Date
  title_count          Int      @default(0)
  content              String   @db.Text
  model                String?  @db.VarChar(80)
  prompt_version       String?  @db.VarChar(32)
  recipe_name_snapshot String   @db.VarChar(80)
  /// 标题列表短 hash，仅 meta，不参与是否秒开
  input_fingerprint    String?  @db.VarChar(64)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe               UserInsightRecipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, recipe_id, scope_key, run_day, created_at(sort: Desc)], map: "idx_insight_recipe_runs_lookup")
  @@index([user_id, created_at], map: "idx_insight_recipe_runs_user_created")
  @@map("user_insight_recipe_runs")
}
